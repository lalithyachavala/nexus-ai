# ---- Nexus AI backend configuration ----
# All values are optional; the API boots with safe defaults (SQLite + mock AI).

# Database. Leave unset for the zero-setup SQLite fallback.
# Supabase / Postgres example:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./nexus.db

# AI adapter: mock (default, no key) | openai | claude
LLM_PROVIDER=mock
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_MODEL=claude-sonnet-5

# Comma-separated CORS origins (the Next.js dev server).
CORS_ORIGINS=http://localhost:3000
